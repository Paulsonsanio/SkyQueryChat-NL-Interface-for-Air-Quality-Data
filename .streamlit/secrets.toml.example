# Streamlit Community Cloud Secrets Template
# On Streamlit Community Cloud: Go to App Settings -> Secrets and paste your keys:

# Groq API Key (for LLM reasoning planner)
GROQ_API_KEY = "gsk_your_groq_api_key_here"

# Model name (default is LLaMA 3.3 70B via Groq)
SKYQUERY_MODEL = "openai/gpt-oss-120b"

# Optional: NASA Earthdata Token for fetching live OMI/Aura granules
# EARTHDATA_TOKEN = "your_earthdata_bearer_token"
